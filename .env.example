ECOFLOW_ACCESS_KEY=replace-me
ECOFLOW_SECRET_KEY=replace-me
ECOFLOW_API_ENDPOINT=https://api-e.ecoflow.com
ECOFLOW_MQTT_BROKER=mqtt-e.ecoflow.com
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Enable only on a protected production deployment
DASHBOARD_UPDATES_ENABLED=false
DASHBOARD_UPDATE_BRANCH=main
DASHBOARD_SYSTEMD_SERVICE=
# 'git' runs the update in place; 'host-agent' delegates it to the host updater
# (deploy/ecoflow-updater.path) and is the only mode that works inside a container.
DASHBOARD_UPDATE_MODE=git
# Prune device_states/operation_logs older than N days. 0 keeps everything.
DASHBOARD_RETENTION_DAYS=0
# Optional: EcoFlow app channel (Settings -> EcoFlow app channel) for devices the Open API
# serves only in part, e.g. one shared from another account. The Settings login keeps
# only a token; set these instead to sign in by itself and again when the token expires.
# ECOFLOW_APP_EMAIL=
# ECOFLOW_APP_PASSWORD=
# ECOFLOW_APP_REGION=api-e
