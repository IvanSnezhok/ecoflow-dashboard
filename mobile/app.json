{
  "expo": {
    "name": "EcoFlow Panel",
    "slug": "ecoflow-panel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecoflowpanel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.ecoflowpanel.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ecoflowpanel.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B111E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#12D393",
          "defaultChannel": "alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B111E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "enableAndroid": true,
          "widgets": [
            {
              "name": "StationWidget",
              "displayName": "EcoFlow Panel",
              "description": "Battery level, power and outage state of your station",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/station.ios.tsx"
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 110,
                "initialLayout": "./src/widgets/station.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
